 "sign_convention": "I = Delta_Q - Delta_B = Y_BQ + Y_QB - Y_BB - Y_QQ, Delta_Q = Y_BQ - Y_QQ, Delta_B = Y_BB - Y_QB",
 "estimator": {
  "Ihat": "Ybar_BQ + Ybar_QB - Ybar_BB - Ybar_QQ",
  "U": "Ihat^2 - sum_a Ybar_a (1 - Ybar_a) / (n_a - 1)  (unbiased for I_s^2 under the assumptions)",
  "pool": "equal weight over the 4 cells (20 states each)",
  "truncation": "none (negative values kept)"
 },
 "assumptions": [
  "Given the state, the n_a replicates of each arm are i.i.d. Bernoulli(p_a,s) (the simulator and controllers are re-sampled independently per replicate; no shared cache or seed across replicates).",
  "The four arms of a state are mutually independent given the state (no shared randomness across arms).",
  "n_a \u2265 2 valid replicates per arm (here n_a = 5 for every arm: no missing replicate).",
  "Unbiasedness is per state and conditional on the state; the pooled mean of U estimates the equal-weight-over-cells average of I_s\u00b2 over these 80 frozen states (20 per cell), not over any wider state population.",
  "Unexposed branches (10 BB, 10 QB arm-replicates with 0 user calls) keep their Y, as in the final SIMCTRL-P analysis."
 ],
 "intervals": {
  "states": "bootstrap over states stratified by cell (analyze_simctrl_p.Boots.strat)",
  "task_cluster": "per cell: tasks within the cell resampled; pool: tasks resampled once across cells (Boots.Wcell / Wpool)"
 },
